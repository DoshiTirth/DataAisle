<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DataAisle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- ── Sidebar ── -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-icon">
                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                        <rect x="1" y="1" width="9" height="9" rx="2" fill="#6366f1"/>
                        <rect x="12" y="1" width="9" height="9" rx="2" fill="#6366f1" opacity="0.5"/>
                        <rect x="1" y="12" width="9" height="9" rx="2" fill="#6366f1" opacity="0.5"/>
                        <rect x="12" y="12" width="9" height="9" rx="2" fill="#6366f1" opacity="0.3"/>
                    </svg>
                </div>
                <div>
                    <div class="logo-text">DataAisle</div>
                    <div class="logo-sub">Warehouse Dashboard</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main</div>

                <a asp-controller="Dashboard" asp-action="Index"
                   class="nav-item @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="1" width="6" height="6" rx="1.5"/>
                        <rect x="9" y="1" width="6" height="6" rx="1.5"/>
                        <rect x="1" y="9" width="6" height="6" rx="1.5"/>
                        <rect x="9" y="9" width="6" height="6" rx="1.5"/>
                    </svg>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Runs" asp-action="Index"
                   class="nav-item @(ViewData["ActivePage"]?.ToString() == "Runs" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 4h12M2 8h9M2 12h6"/>
                    </svg>
                    <span>Pipeline runs</span>
                </a>

                <a asp-controller="Quality" asp-action="Index"
                   class="nav-item @(ViewData["ActivePage"]?.ToString() == "Quality" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M8 1l1.8 3.6L14 5.6l-3 2.9.7 4.1L8 10.5l-3.7 2.1.7-4.1L2 5.6l4.2-.97z"/>
                    </svg>
                    <span>Data quality</span>
                </a>

                <div class="nav-section-label">Warehouse</div>

                <a asp-controller="Warehouse" asp-action="Index"
                   class="nav-item @(ViewData["ActivePage"]?.ToString() == "Warehouse" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <ellipse cx="8" cy="5" rx="6" ry="2.5"/>
                        <path d="M2 5v6c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V5"/>
                        <path d="M2 8c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5"/>
                    </svg>
                    <span>Warehouse stats</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="user-avatar">DA</div>
                    <div class="user-info">
                        <div class="user-name">DataAisle</div>
                        <div class="user-role">Admin</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── Main area ── -->
        <div class="main-area">

            <!-- Top bar -->
            <header class="topbar">
                <div class="topbar-left">
                    <div class="page-title">@ViewData["Title"]</div>
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <div class="breadcrumb">@ViewData["Breadcrumb"]</div>
                    }
                </div>
                <div class="topbar-right">
                    <span class="topbar-timestamp">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.3" style="vertical-align:-2px;margin-right:4px;opacity:0.5">
                            <circle cx="6.5" cy="6.5" r="5.5"/>
                            <path d="M6.5 3.5v3l2 1.5"/>
                        </svg>
                        @DateTime.Now.ToString("MMM dd, HH:mm")
                    </span>
                    <a asp-controller="Runs" asp-action="Trigger"
                       class="btn-primary run-pipeline-btn"
                       id="runPipelineBtn">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5" style="vertical-align:-1px;margin-right:5px">
                            <polygon points="3,1 12,6.5 3,12" fill="currentColor" stroke="none"/>
                        </svg>
                        Run pipeline
                    </a>
                </div>
            </header>

            <!-- Page content -->
            <main class="page-content">
                <div class="content-fade-in">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    <script src="~/js/animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
