@model DataAisle.Web.Models.ErrorViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Something went wrong";
    ViewData["ActivePage"] = "";
}

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 24px;text-align:center;">

    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:20px;opacity:0.25">
        <circle cx="24" cy="24" r="22" stroke="#0f172a" stroke-width="2"/>
        <path d="M24 14v12M24 32v2" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round"/>
    </svg>

    <h1 style="font-size:18px;font-weight:600;color:#0f172a;margin-bottom:8px;">Something went wrong</h1>
    <p style="font-size:13px;color:#64748b;max-width:400px;line-height:1.6;margin-bottom:24px;">
        An unexpected error occurred while processing your request.
        @if (Model?.ShowRequestId == true)
        {
            <span>Request ID: <code style="font-family:Consolas,monospace;font-size:12px;background:#f1f5f9;padding:2px 6px;border-radius:4px;">@Model.RequestId</code></span>
        }
    </p>

    <a asp-controller="Dashboard" asp-action="Index" class="btn-primary">
        ← Back to dashboard
    </a>

</div>
